# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=PricePilot AI
LOG_LEVEL=INFO

# ── Data layer ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the CSV in-memory (standalone / Cloud Run).
DATABASE_URL=
DATASET_PATH=data/dataset.csv

# ── Cache ─────────────────────────────────────────────────────────────────────
# In-memory TTL cache (cachetools). No external service required.
CACHE_TTL_SECONDS=86400
CACHE_MAX_SIZE=512

# ── LLM ───────────────────────────────────────────────────────────────────────
# Required only for the /api/v1/agents endpoints.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000
