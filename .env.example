# ---- LLM (required for the AI agents feature) ------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ---- Postgres (docker compose creates the DB with these) -------------------
POSTGRES_USER=pricepilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pricepilot

# ---- URLs -------------------------------------------------------------------
# Origin the backend allows for CORS (the frontend URL)
FRONTEND_ORIGIN=http://localhost:3000
# Backend URL baked into the frontend at build time
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO

# The following are set automatically inside docker compose; you only need
# them when running the backend directly on your machine:
# DATABASE_URL=postgresql+psycopg2://pricepilot:change-me@localhost:5432/pricepilot
# REDIS_URL=redis://localhost:6379/0
# DATASET_PATH=data/dataset.csv
